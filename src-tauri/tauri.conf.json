{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ByteMap",
  "version": "1.0.2",
  "identifier": "com.bytemap.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ByteMap — Desktop Storage Intelligence",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://github.com https://objects.githubusercontent.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDQUMwMkFBNDZCNjM0OUIKUldTYk5MWkdxZ0tzREdyNTcrZkw1Wk91K3o1WVdPR2RQbmorc3hxS2phNUNad00yTU9kNTVwS2YK",
      "endpoints": [
        "https://github.com/ankitpandey1900/ByteMap/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Ankit Pandey",
    "shortDescription": "Desktop Storage Intelligence",
    "longDescription": "A fast, offline desktop storage intelligence tool with a vibrant comic-book visualizer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
